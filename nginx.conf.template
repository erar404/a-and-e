server {
    listen       ${PORT};
    listen  [::]:${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    # format.html is the public-facing disguise (a generic AI tone
    # formatter) — the real site only opens past its sign-in modal, so
    # it's what the bare domain serves by default. index.html itself is
    # untouched and still reachable directly (that's the sign-in
    # redirect target).
    index  format.html;

    gzip on;
    gzip_types text/css application/javascript text/plain image/svg+xml;

    # photos / video / music — cache hard, they never change
    location ~* \.(jpg|jpeg|png|mp4|mp3|mov)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # pages, scripts, styles, data — always revalidate so fixes land at once
    location ~* \.(html|js|css|json)$ {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /format.html;
        add_header Cache-Control "no-cache";
    }

    # "jipiti <prompt>" chat command — proxied to the python process
    # started by docker/30-start-jipiti.sh, bound to 127.0.0.1 only.
    location /api/jipiti {
        proxy_pass http://127.0.0.1:8001/jipiti;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 65s;
    }

    # Anniversareels — same-origin streaming proxy for the shared Drive
    # folder's clips (reels.js asks for /reels/<fileId>). Google refuses
    # to be hotlinked by a <video> tag on another site: any request that
    # carries the browser's Sec-Fetch-Dest: video headers gets a 403 HTML
    # page, while the very same URL answers a plain range request with
    # 206 Partial Content + video/mp4. So nginx makes the request on the
    # browser's behalf — forwards Range, drops cookies / Referer / the
    # Sec-Fetch headers, and streams the bytes straight back unbuffered,
    # which keeps seeking and progressive playback intact. The clips are
    # public "anyone with the link" files; nothing here needs a key.
    # (tools/dev-server.mjs mirrors this for local previews.)
    location ~ ^/reels/([-\w]+)$ {
        resolver 8.8.8.8 1.1.1.1 valid=300s ipv6=off;
        set $reel_id $1;
        set $drive_host drive.usercontent.google.com;

        proxy_pass https://$drive_host/download?id=$reel_id&export=download;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name $drive_host;

        proxy_set_header Host $drive_host;
        proxy_set_header Connection "";
        proxy_set_header Range $http_range;
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Origin "";
        proxy_set_header Sec-Fetch-Dest "";
        proxy_set_header Sec-Fetch-Mode "";
        proxy_set_header Sec-Fetch-Site "";
        proxy_set_header Sec-Fetch-User "";
        proxy_set_header User-Agent "walong-buwan-reels/1.0";

        proxy_buffering off;
        proxy_force_ranges on;
        proxy_read_timeout 60s;
        proxy_hide_header Content-Disposition;
        proxy_hide_header Set-Cookie;
        add_header Cache-Control "public, max-age=86400";
    }
}
